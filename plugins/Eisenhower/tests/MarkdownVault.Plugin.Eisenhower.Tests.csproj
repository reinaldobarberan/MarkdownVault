<Project Sdk="Microsoft.NET.Sdk">

  <!-- Tests del plugin Eisenhower. Vive DENTRO de la carpeta del plugin y NO referencia
       MarkdownVault.csproj a propósito: un plugin es OPCIONAL, así que sus tests no
       pueden ser una dependencia de compilación del host ni al revés. Borrar
       plugins/Eisenhower/ entero (más sus dos entradas del .sln) tiene que dejar el
       resto del repo compilando. -->

  <PropertyGroup>
    <!-- net8.0-windows porque el csproj del plugin lo es (UseWPF). El FrameworkReference
         de WPF llega solo por el ProjectReference — mismo motivo por el que
         MarkdownVault.Tests tampoco declara UseWPF. -->
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <AssemblyName>MarkdownVault.Plugin.Eisenhower.Tests</AssemblyName>
    <RootNamespace>MarkdownVault.Plugin.Eisenhower.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk"        Version="17.11.1" />
    <PackageReference Include="xunit"                         Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio"     Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- ÚNICA referencia de proyecto: el propio plugin, que ya arrastra PluginSdk.
         Nada del host. -->
    <ProjectReference Include="..\MarkdownVault.Plugin.Eisenhower.csproj" />
    <!-- Markdig: EisenhowerRenderExtensionTests arma un pipeline Markdig REAL. Acá SÍ
         hace falta el runtime del paquete (sin ExcludeAssets): en el plugin se excluye
         porque el host provee el DLL y lo comparte por el ALC, pero este proceso de
         tests NO es el host — si el DLL no se copia junto al .dll de tests, el pipeline
         revienta al ejecutarse. Misma versión que el plugin. -->
    <PackageReference Include="Markdig" Version="1.1.2" />
  </ItemGroup>

</Project>
