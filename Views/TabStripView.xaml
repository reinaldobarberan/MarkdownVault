<UserControl x:Class="MarkdownVault.Views.TabStripView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MouseMove="Strip_MouseMove"
             MouseLeftButtonUp="Strip_MouseLeftButtonUp"
             LostMouseCapture="Strip_LostMouseCapture">

    <!-- ── Tab strip (extracted from EditorView, task 3.10 → reusable so it can appear
         both inside each editor pane AND above the preview in Solo visor). Its ambient
         DataContext is an EditorGroupViewModel, so OpenTabs/CloseTabCommand/HasFile
         resolve directly. Hidden when the group has no file. ── -->
    <Border Background="{DynamicResource TabBarBackground}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,0,0,1"
            Visibility="{Binding HasFile, Converter={StaticResource BoolToVisConverter}}">
        <ScrollViewer HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Disabled"
                      CanContentScroll="False"
                      Padding="0">
            <ScrollViewer.Resources>
                <Style TargetType="ScrollBar">
                    <Setter Property="Height" Value="3"/>
                </Style>
            </ScrollViewer.Resources>
            <ItemsControl x:Name="TabsHost" ItemsSource="{Binding OpenTabs}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="TabBorder"
                                Background="{DynamicResource TabInactiveBackground}"
                                BorderThickness="0,2,0,0"
                                BorderBrush="Transparent"
                                Margin="0,0,1,0"
                                Padding="10,5,4,5"
                                Cursor="Hand"
                                MinWidth="80" MaxWidth="200"
                                ToolTip="{Binding FilePath}"
                                ToolTipService.InitialShowDelay="600"
                                ToolTipService.ShowDuration="20000"
                                MouseLeftButtonDown="Tab_MouseLeftButtonDown"
                                MouseDown="Tab_MouseDown"
                                Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}">
                            <!-- ContextMenu content is a separate Popup visual root, so
                                 RelativeSource AncestorType=Window does NOT resolve inside
                                 it directly (would fail silently — the exact binding-scope
                                 trap flagged for this batch). Standard WPF workaround:
                                 TabBorder.Tag above carries the Window's DataContext
                                 (MainViewModel); PlacementTarget is a plain DP set by WPF
                                 to whatever opened the menu (TabBorder), reachable from
                                 inside the popup via AncestorType=ContextMenu (which DOES
                                 resolve — the MenuItem IS inside the ContextMenu's own tree). -->
                            <Border.ContextMenu>
                                <ContextMenu>
                                    <!-- Only meaningful when split — a second pane must
                                         exist to move the tab into (SE-12). -->
                                    <MenuItem Header="Mover al otro panel"
                                              Command="{Binding PlacementTarget.Tag.MoveTabToOtherPanelCommand,
                                                        RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              CommandParameter="{Binding}"
                                              Visibility="{Binding PlacementTarget.Tag.IsSplit,
                                                           RelativeSource={RelativeSource AncestorType=ContextMenu},
                                                           Converter={StaticResource BoolToVisConverter}}"/>
                                </ContextMenu>
                            </Border.ContextMenu>
                            <DockPanel>
                                <!-- Close button -->
                                <Button x:Name="CloseBtn"
                                        DockPanel.Dock="Right"
                                        Content="&#xE711;"
                                        FontFamily="Segoe MDL2 Assets"
                                        FontSize="9"
                                        Width="18" Height="18"
                                        Margin="6,0,0,0"
                                        VerticalAlignment="Center"
                                        Cursor="Hand"
                                        Opacity="0"
                                        Command="{Binding DataContext.CloseTabCommand,
                                                  RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="CloseBg"
                                                    Background="Transparent"
                                                    CornerRadius="3"
                                                    Padding="2">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"
                                                                  TextElement.Foreground="{DynamicResource SubtleForeground}"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="CloseBg" Property="Background"
                                                            Value="{DynamicResource TabCloseHover}"/>
                                                    <Setter Property="Foreground" Value="White"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>

                                <!-- File name -->
                                <TextBlock x:Name="TabText"
                                           Text="{Binding DisplayName}"
                                           FontSize="12"
                                           Foreground="{DynamicResource TabInactiveForeground}"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"/>
                            </DockPanel>
                        </Border>
                        <DataTemplate.Triggers>
                            <!-- Show close on hover (declared first so active overrides) -->
                            <Trigger SourceName="TabBorder" Property="IsMouseOver" Value="True">
                                <Setter TargetName="CloseBtn" Property="Opacity" Value="1"/>
                                <Setter TargetName="TabBorder" Property="Background"
                                        Value="{DynamicResource TabHoverBackground}"/>
                            </Trigger>
                            <!-- Active tab styling (declared last → wins over hover) -->
                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                <Setter TargetName="TabBorder" Property="Background"
                                        Value="{DynamicResource TabActiveBackground}"/>
                                <Setter TargetName="TabBorder" Property="BorderBrush"
                                        Value="{DynamicResource TabActiveBorder}"/>
                                <Setter TargetName="TabText" Property="Foreground"
                                        Value="{DynamicResource Foreground}"/>
                                <Setter TargetName="CloseBtn" Property="Opacity" Value="1"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Border>
</UserControl>
