<Window x:Class="MarkdownVault.Views.UnsavedChangesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cambios sin guardar"
        Width="480" SizeToContent="Height"
        MinHeight="180"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource WindowBackground}"
        Foreground="{DynamicResource Foreground}">

    <!-- Mismo molde que AboutWindow / VaultsWindow: los colores salen SIEMPRE de
         DynamicResource para que el diálogo siga el tema claro/oscuro vivo (ApplyTheme
         reemplaza el diccionario combinado de la aplicación en caliente). -->
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding"  Value="14,6"/>
            <Setter Property="MinWidth" Value="96"/>
            <Setter Property="Margin"   Value="6,0,0,0"/>
            <Setter Property="Cursor"   Value="Hand"/>
        </Style>
    </Window.Resources>

    <StackPanel Margin="20,18,20,16">

        <TextBlock x:Name="HeadlineText"
                   FontSize="14" FontWeight="SemiBold"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource Foreground}"/>

        <!-- Los NOMBRES, no un "hay cambios sin guardar" genérico: con el genérico el usuario
             no puede decidir nada. Con scroll porque la lista no tiene techo. -->
        <Border Margin="0,10,0,0"
                Padding="10,8"
                CornerRadius="3"
                BorderThickness="1"
                BorderBrush="{DynamicResource BorderBrush}"
                Background="{DynamicResource PanelBackground}">
            <ScrollViewer MaxHeight="180" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="DocumentList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}"
                                       Margin="0,1"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource Foreground}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- Operación larga en vuelo (dictado, transcripción). Solo se muestra si el host
             REALMENTE lo sabe: sale de la barra de progreso de plugins. -->
        <Border x:Name="BusyPanel"
                Visibility="Collapsed"
                Margin="0,10,0,0"
                Padding="10,7"
                CornerRadius="3"
                Background="{DynamicResource HoverBackground}">
            <TextBlock x:Name="BusyText"
                       TextWrapping="Wrap"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource Foreground}"/>
        </Border>

        <TextBlock x:Name="NeverSavedText"
                   Visibility="Collapsed"
                   Margin="0,10,0,0"
                   TextWrapping="Wrap"
                   FontSize="12"
                   Foreground="{DynamicResource SubtleForeground}"/>

        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button x:Name="SaveButton"
                    Content="Guardar y salir"
                    IsDefault="True"
                    Click="Save_Click"/>
            <Button Content="Salir sin guardar" Click="Discard_Click"/>
            <!-- IsCancel: Esc y la X del título caen acá, que es la opción segura. -->
            <Button Content="Cancelar" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
