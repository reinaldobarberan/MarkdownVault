<Window x:Class="MarkdownVault.Views.VaultsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Administrar vaults"
        Height="480" Width="600"
        MinHeight="320" MinWidth="460"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource WindowBackground}"
        Foreground="{DynamicResource Foreground}">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding"  Value="14,6"/>
            <Setter Property="MinWidth" Value="80"/>
            <Setter Property="Margin"   Value="4,0,0,0"/>
            <Setter Property="Cursor"   Value="Hand"/>
        </Style>
    </Window.Resources>

    <DockPanel Margin="16">

        <!-- ── Header ── -->
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <TextBlock Text="Vaults"
                       FontSize="18" FontWeight="SemiBold"
                       Foreground="{DynamicResource Foreground}"/>
            <TextBlock Margin="0,4,0,0" FontSize="11" TextWrapping="Wrap"
                       Foreground="{DynamicResource SubtleForeground}"
                       Text="Abrí o cerrá cada vault de forma independiente — podés tener varios abiertos a la vez, cada uno en su propia sección del explorador. Cerrar un vault no cierra sus pestañas abiertas."/>
        </StackPanel>

        <!-- ── Footer ── -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Agregar carpeta…" Command="{Binding AddVaultCommand}"/>
            <Button Content="Cerrar"           IsCancel="True"/>
        </StackPanel>

        <!-- ── Vault list ── -->
        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4">
            <Grid>
                <!-- Empty state -->
                <TextBlock Text="Todavía no agregaste ningún vault. Usá «Agregar carpeta…»."
                           Foreground="{DynamicResource SubtleForeground}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           FontSize="12" TextWrapping="Wrap" TextAlignment="Center"
                           Margin="24,0"
                           Visibility="{Binding HasVaults, Converter={StaticResource InverseBoolToVisConverter}}"/>

                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding HasVaults, Converter={StaticResource BoolToVisConverter}}">
                    <ItemsControl ItemsSource="{Binding Vaults}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="12,10"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}"
                                                           FontWeight="SemiBold" FontSize="14"
                                                           Foreground="{DynamicResource Foreground}"
                                                           VerticalAlignment="Center"/>
                                                <!-- Open badge -->
                                                <Border Margin="8,0,0,0" Padding="5,1" CornerRadius="3"
                                                        VerticalAlignment="Center"
                                                        Background="{DynamicResource AccentBrush}"
                                                        Visibility="{Binding IsOpen, Converter={StaticResource BoolToVisConverter}}">
                                                    <TextBlock Text="Abierto" FontSize="10" Foreground="White"/>
                                                </Border>
                                                <!-- Missing badge -->
                                                <Border Margin="8,0,0,0" Padding="5,1" CornerRadius="3"
                                                        VerticalAlignment="Center"
                                                        Background="#E06C75"
                                                        Visibility="{Binding IsMissing, Converter={StaticResource BoolToVisConverter}}">
                                                    <TextBlock Text="No encontrada" FontSize="10" Foreground="White"/>
                                                </Border>
                                            </StackPanel>

                                            <TextBlock Text="{Binding FullPath}" TextWrapping="Wrap"
                                                       Margin="0,3,8,0" FontSize="11"
                                                       Foreground="{DynamicResource SubtleForeground}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                    VerticalAlignment="Center">
                                            <Button MinWidth="64"
                                                    IsEnabled="{Binding CanToggle}"
                                                    Command="{Binding DataContext.ToggleOpenCommand,
                                                              RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding FullPath}">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                        <Setter Property="Content" Value="Abrir"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsOpen}" Value="True">
                                                                <Setter Property="Content" Value="Cerrar"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                            <Button Content="Quitar"
                                                    MinWidth="64"
                                                    IsEnabled="{Binding IsRemovable}"
                                                    Command="{Binding DataContext.RemoveVaultCommand,
                                                              RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding FullPath}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </DockPanel>
</Window>
