<Window x:Class="MarkdownVault.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Acerca de MarkdownVault"
        Width="380" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource WindowBackground}"
        Foreground="{DynamicResource Foreground}">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding"  Value="14,6"/>
            <Setter Property="MinWidth" Value="80"/>
            <Setter Property="Cursor"   Value="Hand"/>
        </Style>
    </Window.Resources>

    <StackPanel Margin="24,20,24,16" HorizontalAlignment="Center">

        <Image Source="pack://application:,,,/image/logo_app.png"
               Width="96" Height="96"
               Stretch="Uniform"
               RenderOptions.BitmapScalingMode="HighQuality"/>

        <TextBlock Text="MarkdownVault"
                   FontSize="20" FontWeight="SemiBold"
                   Foreground="{DynamicResource Foreground}"
                   HorizontalAlignment="Center"
                   Margin="0,14,0,0"/>

        <TextBlock Text="Editor de Markdown"
                   FontSize="12"
                   Foreground="{DynamicResource SubtleForeground}"
                   HorizontalAlignment="Center"
                   Margin="0,2,0,0"/>

        <!-- Version y sello de compilado: NO se escriben aca. Se resuelven en
             runtime desde los atributos del ensamblado (ver Version.props). -->
        <Border Margin="0,12,0,0" Padding="8,3" CornerRadius="3"
                HorizontalAlignment="Center"
                Background="{DynamicResource HoverBackground}">
            <TextBlock x:Name="VersionText"
                       FontSize="11"
                       HorizontalAlignment="Center"
                       Foreground="{DynamicResource SubtleForeground}"/>
        </Border>

        <TextBlock x:Name="BuildText"
                   FontSize="10"
                   HorizontalAlignment="Center"
                   Margin="0,5,0,0"
                   Foreground="{DynamicResource SubtleForeground}"/>

        <Border Margin="0,16,0,0" Height="1"
                Background="{DynamicResource BorderBrush}"
                HorizontalAlignment="Stretch"/>

        <TextBlock FontSize="12"
                   Foreground="{DynamicResource Foreground}"
                   HorizontalAlignment="Center"
                   Margin="0,16,0,0">Desarrollado por Reinaldo Barber&#225;n</TextBlock>

        <TextBlock x:Name="CopyrightText"
                   FontSize="10"
                   Foreground="{DynamicResource SubtleForeground}"
                   HorizontalAlignment="Center"
                   Margin="0,4,0,0"/>

        <Button Content="Cerrar"
                IsDefault="True" IsCancel="True"
                HorizontalAlignment="Center"
                Margin="0,20,0,0"/>
    </StackPanel>
</Window>
