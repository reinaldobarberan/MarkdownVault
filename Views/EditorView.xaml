<UserControl x:Class="MarkdownVault.Views.EditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:avalonEdit="http://icsharpcode.net/sharpdevelop/avalonedit"
             xmlns:views="clr-namespace:MarkdownVault.Views"
             AllowDrop="True"
             Drop="EditorView_Drop"
             DragOver="EditorView_DragOver">

    <UserControl.Resources>
        <!-- Plantillas para los items de barra aportados por plugins -->
        <DataTemplate x:Key="PluginSingleTemplate">
            <!-- Content por defecto = Title (texto), igual que siempre. Si el plugin
                 declaró Icon (HasIcon=True), el DataTrigger pisa Content por el glifo
                 y cambia la fuente a Segoe MDL2 Assets. ToolTip siempre muestra Title. -->
            <Button ToolTip="{Binding Title}"
                    Command="{Binding Command}"
                    Margin="1,0">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource ToolbarButtonStyle}">
                        <Setter Property="Content" Value="{Binding Title}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasIcon}" Value="True">
                                <Setter Property="Content"     Value="{Binding Icon}"/>
                                <Setter Property="FontFamily"  Value="Segoe MDL2 Assets"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </DataTemplate>

        <DataTemplate x:Key="PluginGroupTemplate">
            <!-- Mismo criterio que PluginSingleTemplate: por defecto el desplegable muestra
                 el Title como texto; si el plugin declaró Icon, muestra el glifo. El ToolTip
                 SIEMPRE lleva el Title — un icono sin tooltip obliga a adivinar, y eso es
                 peor que el texto que vino a reemplazar.

                 El chevron va en un TextBlock aparte con la fuente por defecto a propósito:
                 "▾" (U+25BE) NO está en Segoe MDL2 Assets, así que meterlo en el mismo run
                 que el glifo lo dejaría como un cuadrado vacío. -->
            <Menu Background="Transparent" VerticalAlignment="Center">
                <!-- Mismo criterio que el desplegable de Código: el grupo no tiene comando, así que
                     su portón se ata a mano. Acá el DataContext es el PluginToolbarItemViewModel,
                     no el grupo de edición, de ahí el salto por RelativeSource hasta EditorView. -->
                <MenuItem FontSize="13" Padding="6,2"
                          ToolTip="{Binding Title}"
                          IsEnabled="{Binding DataContext.HasOpenDocument,
                                      RelativeSource={RelativeSource AncestorType=views:EditorView}}"
                          Foreground="{DynamicResource Foreground}"
                          Background="Transparent"
                          ItemsSource="{Binding Children}">
                    <MenuItem.Style>
                        <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                            <Setter Property="Header" Value="{Binding Title, StringFormat={}{0} &#x25BE;}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasIcon}" Value="True">
                                    <Setter Property="Header" Value="{Binding Icon}"/>
                                    <Setter Property="HeaderTemplate">
                                        <Setter.Value>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding}" FontFamily="Segoe MDL2 Assets"/>
                                                    <TextBlock Text="&#x25BE;" Margin="4,0,0,0"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </MenuItem.Style>
                    <MenuItem.ItemContainerStyle>
                        <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                            <Setter Property="Header"  Value="{Binding Title}"/>
                            <Setter Property="Command" Value="{Binding Command}"/>
                        </Style>
                    </MenuItem.ItemContainerStyle>
                </MenuItem>
            </Menu>
        </DataTemplate>

        <views:PluginToolbarItemTemplateSelector x:Key="PluginItemSelector"
            SingleTemplate="{StaticResource PluginSingleTemplate}"
            GroupTemplate="{StaticResource PluginGroupTemplate}"/>
    </UserControl.Resources>

    <DockPanel Background="{DynamicResource EditorBackground}">

        <!-- ── Tab strip (per-pane). Extracted to TabStripView so the same control can also
             appear above the preview in Solo visor. Ambient DataContext IS the group, so the
             control's OpenTabs/CloseTabCommand/HasFile bindings resolve directly. ── -->
        <views:TabStripView DockPanel.Dock="Top"/>

        <!-- ── Toolbar ── -->
        <Border DockPanel.Dock="Top"
                Background="{DynamicResource ToolBarBackground}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="4,2">
          <DockPanel>

            <ToolBar Background="Transparent" Padding="0" TextElement.Foreground="{DynamicResource Foreground}">
                <ToolBar.Resources>
                    <Style x:Key="{x:Static ToolBar.ButtonStyleKey}" TargetType="Button" BasedOn="{StaticResource ToolbarButtonStyle}"/>
                </ToolBar.Resources>

                <Button ToolTip="Negrita (Ctrl+B)"
                        Command="{Binding InsertBoldCommand}"
                        Content="B" FontWeight="Bold"/>
                <Button ToolTip="Cursiva (Ctrl+I)"
                        Command="{Binding InsertItalicCommand}"
                        Content="I" FontStyle="Italic"/>
                <Button ToolTip="Código en línea"
                        Command="{Binding InsertCodeCommand}"
                        Content="`" FontFamily="Consolas"/>
                <Separator/>

                <Button ToolTip="Título 1" Command="{Binding InsertHeading1Command}" Content="H1" FontWeight="Bold"/>
                <Button ToolTip="Título 2" Command="{Binding InsertHeading2Command}" Content="H2" FontWeight="Bold"/>
                <Button ToolTip="Título 3" Command="{Binding InsertHeading3Command}" Content="H3" FontWeight="Bold"/>
                <Separator/>

                <Button ToolTip="Lista con viñetas"  Command="{Binding InsertBulletListCommand}"   Content="&#x2022;&#x2022;&#x2022;"/>
                <Button ToolTip="Lista numerada"     Command="{Binding InsertNumberedListCommand}" Content="1."/>
                <Separator/>

                <Button ToolTip="Insertar enlace web"     Command="{Binding InsertLinkCommand}"         Content="&#xE71B;"  FontFamily="Segoe MDL2 Assets"/>
                <Button ToolTip="Insertar enlace interno" Command="{Binding InsertInternalLinkCommand}" Content="&#xE8F1;"  FontFamily="Segoe MDL2 Assets"/>
                <Button ToolTip="Insertar imagen"         Command="{Binding InsertImageCommand}"        Content="&#xEB9F;"  FontFamily="Segoe MDL2 Assets"/>
                <Separator/>

                <!-- Code-block dropdown -->
                <Menu Background="Transparent" VerticalAlignment="Center">
                    <!-- El desplegable no tiene comando propio, así que su CanExecute no lo apaga:
                         se ata a mano al mismo portón que sus hijos. Si no, sin documento abierto
                         quedaría vivo y abriría un menú con todo adentro en gris. -->
                    <MenuItem Header="{}Código &#x25BE;"
                              FontFamily="Consolas" FontSize="13"
                              Padding="6,2"
                              ToolTip="Insertar bloque de código"
                              IsEnabled="{Binding HasOpenDocument}"
                              Foreground="{DynamicResource Foreground}"
                              Background="Transparent">
                        <MenuItem Header="C#"          FontFamily="Consolas"
                                  Command="{Binding InsertCodeBlockCommand}" CommandParameter="csharp"/>
                        <MenuItem Header="SQL"         FontFamily="Consolas"
                                  Command="{Binding InsertCodeBlockCommand}" CommandParameter="sql"/>
                        <MenuItem Header="Python"      FontFamily="Consolas"
                                  Command="{Binding InsertCodeBlockCommand}" CommandParameter="python"/>
                        <MenuItem Header="JavaScript"  FontFamily="Consolas"
                                  Command="{Binding InsertCodeBlockCommand}" CommandParameter="javascript"/>
                        <MenuItem Header="TypeScript"  FontFamily="Consolas"
                                  Command="{Binding InsertCodeBlockCommand}" CommandParameter="typescript"/>
                        <MenuItem Header="Bash/Shell"  FontFamily="Consolas"
                                  Command="{Binding InsertCodeBlockCommand}" CommandParameter="bash"/>
                        <MenuItem Header="JSON"        FontFamily="Consolas"
                                  Command="{Binding InsertCodeBlockCommand}" CommandParameter="json"/>
                        <MenuItem Header="XML/HTML"    FontFamily="Consolas"
                                  Command="{Binding InsertCodeBlockCommand}" CommandParameter="xml"/>
                    </MenuItem>
                </Menu>
                <Separator/>

                <!-- Barra de herramientas aportada por plugins (botones y dropdowns).
                     El dropdown de Mermaid ahora viene del plugin Mermaid. -->
                <ItemsControl ItemsSource="{Binding PluginToolbarItems}"
                              ItemTemplateSelector="{StaticResource PluginItemSelector}"
                              VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </ToolBar>
          </DockPanel>
        </Border>

        <!-- ── Navigation bar (back to previous file via internal link) ── -->
        <Border DockPanel.Dock="Top"
                Background="{DynamicResource ToolBarBackground}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="8,3"
                Visibility="{Binding CanGoBack, Converter={StaticResource BoolToVisConverter}}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button ToolTip="Volver al archivo anterior (Alt+←)"
                        Command="{Binding GoBackCommand}"
                        Cursor="Hand"
                        Padding="4,2"
                        Margin="0,0,6,0"
                        Background="Transparent"
                        BorderThickness="0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72B;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="12"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource Foreground}"
                                   Margin="0,0,4,0"/>
                        <TextBlock VerticalAlignment="Center"
                                   FontSize="12"
                                   Foreground="{DynamicResource SubtleForeground}">
                            <Run Text="Volver a: "/>
                            <Run Text="{Binding GoBackFileName, Mode=OneWay}"
                                 FontWeight="SemiBold"
                                 Foreground="{DynamicResource Foreground}"/>
                        </TextBlock>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <!-- ── Content area: editor ── -->
        <!-- Graph moved to workbench scope in Phase 2 (Decision 2) — MainWindow.xaml now
             binds GraphView directly where this EditorView sits, toggled by the workbench's
             ShowGraph. This UserControl no longer owns any graph-swap logic. -->
        <!-- SyntaxHighlighting is set in code-behind after programmatic registration -->
        <!-- Sin pestaña abierta el panel NO es un editor: es un estado vacío. Antes el área de
             texto quedaba visible y editable, y lo que se escribía ahí no lo persistía nadie
             (EditorGroupViewModel.OnContentChanged solo escribe en ActiveTab), así que la
             primera apertura de archivo lo pisaba sin aviso. Ahora el editor se oculta y en su
             lugar se dice qué hacer. IsReadOnly va igual: doble red, por si alguien vuelve a
             mostrar el control sin revisar esta invariante. -->
        <Grid>
            <avalonEdit:TextEditor
                x:Name="TextEditor"
                ShowLineNumbers="True"
                WordWrap="True"
                Padding="8"
                HorizontalScrollBarVisibility="Auto"
                VerticalScrollBarVisibility="Auto"
                Background="{DynamicResource EditorBackground}"
                Foreground="{DynamicResource Foreground}"
                IsReadOnly="{Binding IsEditorReadOnly}"
                Visibility="{Binding HasOpenDocument, Converter={StaticResource BoolToVisConverter}}"/>

            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        MaxWidth="420"
                        Visibility="{Binding HasOpenDocument, Converter={StaticResource InverseBoolToVisConverter}}">
                <TextBlock Text="&#xE7C3;"
                           FontFamily="Segoe MDL2 Assets"
                           FontSize="42"
                           HorizontalAlignment="Center"
                           Opacity="0.5"
                           Foreground="{DynamicResource SubtleForeground}"/>
                <TextBlock Text="No hay ningún archivo abierto"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Margin="0,14,0,0"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource Foreground}"/>
                <TextBlock Margin="0,6,0,0"
                           FontSize="12"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource SubtleForeground}">
                    <Run Text="Elegí un archivo en el explorador de la izquierda,"/>
                    <LineBreak/>
                    <Run Text="o creá uno nuevo con "/><Run Text="Ctrl+N" FontWeight="SemiBold"/><Run Text="."/>
                </TextBlock>
            </StackPanel>
        </Grid>
    </DockPanel>
</UserControl>
