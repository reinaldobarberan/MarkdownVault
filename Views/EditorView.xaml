<UserControl x:Class="MarkdownVault.Views.EditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:avalonEdit="http://icsharpcode.net/sharpdevelop/avalonedit"
             xmlns:views="clr-namespace:MarkdownVault.Views"
             AllowDrop="True"
             Drop="EditorView_Drop"
             DragOver="EditorView_DragOver">

    <UserControl.Resources>
        <!-- Plantillas para los items de barra aportados por plugins -->
        <DataTemplate x:Key="PluginSingleTemplate">
            <!-- Content por defecto = Title (texto), igual que siempre. Si el plugin
                 declaró Icon (HasIcon=True), el DataTrigger pisa Content por el glifo
                 y cambia la fuente a Segoe MDL2 Assets. ToolTip siempre muestra Title. -->
            <Button ToolTip="{Binding Title}"
                    Command="{Binding Command}"
                    Margin="1,0">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource ToolbarButtonStyle}">
                        <Setter Property="Content" Value="{Binding Title}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasIcon}" Value="True">
                                <Setter Property="Content"     Value="{Binding Icon}"/>
                                <Setter Property="FontFamily"  Value="Segoe MDL2 Assets"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </DataTemplate>

        <DataTemplate x:Key="PluginGroupTemplate">
            <Menu Background="Transparent" VerticalAlignment="Center">
                <MenuItem Header="{Binding Title, StringFormat={}{0} &#x25BE;}"
                          FontSize="13" Padding="6,2"
                          Foreground="{DynamicResource Foreground}"
                          Background="Transparent"
                          ItemsSource="{Binding Children}">
                    <MenuItem.ItemContainerStyle>
                        <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                            <Setter Property="Header"  Value="{Binding Title}"/>
                            <Setter Property="Command" Value="{Binding Command}"/>
                        </Style>
                    </MenuItem.ItemContainerStyle>
                </MenuItem>
            </Menu>
        </DataTemplate>

        <views:PluginToolbarItemTemplateSelector x:Key="PluginItemSelector"
            SingleTemplate="{StaticResource PluginSingleTemplate}"
            GroupTemplate="{StaticResource PluginGroupTemplate}"/>
    </UserControl.Resources>

    <DockPanel Background="{DynamicResource EditorBackground}">

        <!-- ── Tab strip (per-pane, task 3.10 — moved here from MainWindow.xaml, which
             docked it across the FULL window width; now scoped to this pane's column,
             independent scroll/active-styling/close per SE-10). No DataContext override
             needed: this UserControl's ambient DataContext IS the group already, so
             OpenTabs/CloseTabCommand/HasFile resolve directly. ── -->
        <Border DockPanel.Dock="Top"
                Background="{DynamicResource TabBarBackground}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Visibility="{Binding HasFile, Converter={StaticResource BoolToVisConverter}}">
            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Disabled"
                          CanContentScroll="False"
                          Padding="0">
                <ScrollViewer.Resources>
                    <Style TargetType="ScrollBar">
                        <Setter Property="Height" Value="3"/>
                    </Style>
                </ScrollViewer.Resources>
                <ItemsControl ItemsSource="{Binding OpenTabs}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="TabBorder"
                                    Background="{DynamicResource TabInactiveBackground}"
                                    BorderThickness="0,2,0,0"
                                    BorderBrush="Transparent"
                                    Margin="0,0,1,0"
                                    Padding="10,5,4,5"
                                    Cursor="Hand"
                                    MinWidth="80" MaxWidth="200"
                                    MouseLeftButtonDown="Tab_MouseLeftButtonDown"
                                    MouseDown="Tab_MouseDown"
                                    Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}">
                                <!-- ContextMenu content is a separate Popup visual root, so
                                     RelativeSource AncestorType=Window does NOT resolve inside
                                     it directly (would fail silently — the exact binding-scope
                                     trap flagged for this batch). Standard WPF workaround:
                                     TabBorder.Tag above carries the Window's DataContext
                                     (MainViewModel); PlacementTarget is a plain DP set by WPF
                                     to whatever opened the menu (TabBorder), reachable from
                                     inside the popup via AncestorType=ContextMenu (which DOES
                                     resolve — the MenuItem IS inside the ContextMenu's own tree). -->
                                <Border.ContextMenu>
                                    <ContextMenu>
                                        <!-- Only meaningful when split — a second pane must
                                             exist to move the tab into (SE-12). -->
                                        <MenuItem Header="Mover al otro panel"
                                                  Command="{Binding PlacementTarget.Tag.MoveTabToOtherPanelCommand,
                                                            RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding}"
                                                  Visibility="{Binding PlacementTarget.Tag.IsSplit,
                                                               RelativeSource={RelativeSource AncestorType=ContextMenu},
                                                               Converter={StaticResource BoolToVisConverter}}"/>
                                    </ContextMenu>
                                </Border.ContextMenu>
                                <DockPanel>
                                    <!-- Close button -->
                                    <Button x:Name="CloseBtn"
                                            DockPanel.Dock="Right"
                                            Content="&#xE711;"
                                            FontFamily="Segoe MDL2 Assets"
                                            FontSize="9"
                                            Width="18" Height="18"
                                            Margin="6,0,0,0"
                                            VerticalAlignment="Center"
                                            Cursor="Hand"
                                            Opacity="0"
                                            Command="{Binding DataContext.CloseTabCommand,
                                                      RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="CloseBg"
                                                        Background="Transparent"
                                                        CornerRadius="3"
                                                        Padding="2">
                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center"
                                                                      TextElement.Foreground="{DynamicResource SubtleForeground}"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="CloseBg" Property="Background"
                                                                Value="{DynamicResource TabCloseHover}"/>
                                                        <Setter Property="Foreground" Value="White"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>

                                    <!-- File name -->
                                    <TextBlock x:Name="TabText"
                                               Text="{Binding DisplayName}"
                                               FontSize="12"
                                               Foreground="{DynamicResource TabInactiveForeground}"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"/>
                                </DockPanel>
                            </Border>
                            <DataTemplate.Triggers>
                                <!-- Show close on hover (declared first so active overrides) -->
                                <Trigger SourceName="TabBorder" Property="IsMouseOver" Value="True">
                                    <Setter TargetName="CloseBtn" Property="Opacity" Value="1"/>
                                    <Setter TargetName="TabBorder" Property="Background"
                                            Value="{DynamicResource TabHoverBackground}"/>
                                </Trigger>
                                <!-- Active tab styling (declared last → wins over hover) -->
                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                    <Setter TargetName="TabBorder" Property="Background"
                                            Value="{DynamicResource TabActiveBackground}"/>
                                    <Setter TargetName="TabBorder" Property="BorderBrush"
                                            Value="{DynamicResource TabActiveBorder}"/>
                                    <Setter TargetName="TabText" Property="Foreground"
                                            Value="{DynamicResource Foreground}"/>
                                    <Setter TargetName="CloseBtn" Property="Opacity" Value="1"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- ── Toolbar ── -->
        <Border DockPanel.Dock="Top"
                Background="{DynamicResource ToolBarBackground}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="4,2">
          <DockPanel>

            <ToolBar Background="Transparent" Padding="0" TextElement.Foreground="{DynamicResource Foreground}">
                <ToolBar.Resources>
                    <Style x:Key="{x:Static ToolBar.ButtonStyleKey}" TargetType="Button" BasedOn="{StaticResource ToolbarButtonStyle}"/>
                </ToolBar.Resources>

                <Button ToolTip="Negrita (Ctrl+B)"
                        Command="{Binding InsertBoldCommand}"
                        Content="B" FontWeight="Bold"/>
                <Button ToolTip="Cursiva (Ctrl+I)"
                        Command="{Binding InsertItalicCommand}"
                        Content="I" FontStyle="Italic"/>
                <Button ToolTip="Código en línea"
                        Command="{Binding InsertCodeCommand}"
                        Content="`" FontFamily="Consolas"/>
                <Separator/>

                <Button ToolTip="Título 1" Command="{Binding InsertHeading1Command}" Content="H1" FontWeight="Bold"/>
                <Button ToolTip="Título 2" Command="{Binding InsertHeading2Command}" Content="H2" FontWeight="Bold"/>
                <Button ToolTip="Título 3" Command="{Binding InsertHeading3Command}" Content="H3" FontWeight="Bold"/>
                <Separator/>

                <Button ToolTip="Lista con viñetas"  Command="{Binding InsertBulletListCommand}"   Content="&#x2022;&#x2022;&#x2022;"/>
                <Button ToolTip="Lista numerada"     Command="{Binding InsertNumberedListCommand}" Content="1."/>
                <Separator/>

                <Button ToolTip="Insertar enlace web"     Command="{Binding InsertLinkCommand}"         Content="&#xE71B;"  FontFamily="Segoe MDL2 Assets"/>
                <Button ToolTip="Insertar enlace interno" Command="{Binding InsertInternalLinkCommand}" Content="&#xE8F1;"  FontFamily="Segoe MDL2 Assets"/>
                <Button ToolTip="Insertar imagen"         Command="{Binding InsertImageCommand}"        Content="&#xEB9F;"  FontFamily="Segoe MDL2 Assets"/>
                <Separator/>

                <!-- Code-block dropdown -->
                <Menu Background="Transparent" VerticalAlignment="Center">
                    <MenuItem Header="{}Código &#x25BE;"
                              FontFamily="Consolas" FontSize="13"
                              Padding="6,2"
                              ToolTip="Insertar bloque de código"
                              Foreground="{DynamicResource Foreground}"
                              Background="Transparent">
                        <MenuItem Header="C#"          FontFamily="Consolas"
                                  Command="{Binding InsertCodeBlockCommand}" CommandParameter="csharp"/>
                        <MenuItem Header="SQL"         FontFamily="Consolas"
                                  Command="{Binding InsertCodeBlockCommand}" CommandParameter="sql"/>
                        <MenuItem Header="Python"      FontFamily="Consolas"
                                  Command="{Binding InsertCodeBlockCommand}" CommandParameter="python"/>
                        <MenuItem Header="JavaScript"  FontFamily="Consolas"
                                  Command="{Binding InsertCodeBlockCommand}" CommandParameter="javascript"/>
                        <MenuItem Header="TypeScript"  FontFamily="Consolas"
                                  Command="{Binding InsertCodeBlockCommand}" CommandParameter="typescript"/>
                        <MenuItem Header="Bash/Shell"  FontFamily="Consolas"
                                  Command="{Binding InsertCodeBlockCommand}" CommandParameter="bash"/>
                        <MenuItem Header="JSON"        FontFamily="Consolas"
                                  Command="{Binding InsertCodeBlockCommand}" CommandParameter="json"/>
                        <MenuItem Header="XML/HTML"    FontFamily="Consolas"
                                  Command="{Binding InsertCodeBlockCommand}" CommandParameter="xml"/>
                    </MenuItem>
                </Menu>
                <Separator/>

                <!-- Barra de herramientas aportada por plugins (botones y dropdowns).
                     El dropdown de Mermaid ahora viene del plugin Mermaid. -->
                <ItemsControl ItemsSource="{Binding PluginToolbarItems}"
                              ItemTemplateSelector="{StaticResource PluginItemSelector}"
                              VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </ToolBar>
          </DockPanel>
        </Border>

        <!-- ── Navigation bar (back to previous file via internal link) ── -->
        <Border DockPanel.Dock="Top"
                Background="{DynamicResource ToolBarBackground}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="8,3"
                Visibility="{Binding CanGoBack, Converter={StaticResource BoolToVisConverter}}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button ToolTip="Volver al archivo anterior (Alt+←)"
                        Command="{Binding GoBackCommand}"
                        Cursor="Hand"
                        Padding="4,2"
                        Margin="0,0,6,0"
                        Background="Transparent"
                        BorderThickness="0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72B;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="12"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource Foreground}"
                                   Margin="0,0,4,0"/>
                        <TextBlock VerticalAlignment="Center"
                                   FontSize="12"
                                   Foreground="{DynamicResource SubtleForeground}">
                            <Run Text="Volver a: "/>
                            <Run Text="{Binding GoBackFileName, Mode=OneWay}"
                                 FontWeight="SemiBold"
                                 Foreground="{DynamicResource Foreground}"/>
                        </TextBlock>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <!-- ── Content area: editor ── -->
        <!-- Graph moved to workbench scope in Phase 2 (Decision 2) — MainWindow.xaml now
             binds GraphView directly where this EditorView sits, toggled by the workbench's
             ShowGraph. This UserControl no longer owns any graph-swap logic. -->
        <!-- SyntaxHighlighting is set in code-behind after programmatic registration -->
        <avalonEdit:TextEditor
            x:Name="TextEditor"
            ShowLineNumbers="True"
            WordWrap="True"
            Padding="8"
            HorizontalScrollBarVisibility="Auto"
            VerticalScrollBarVisibility="Auto"
            Background="{DynamicResource EditorBackground}"
            Foreground="{DynamicResource Foreground}"/>
    </DockPanel>
</UserControl>
