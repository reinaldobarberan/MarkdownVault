<Window x:Class="MarkdownVault.Views.PluginsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Complementos"
        Height="500" Width="580"
        MinHeight="320" MinWidth="440"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource WindowBackground}"
        Foreground="{DynamicResource Foreground}">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding"  Value="14,6"/>
            <Setter Property="MinWidth" Value="80"/>
            <Setter Property="Margin"   Value="4,0,0,0"/>
            <Setter Property="Cursor"   Value="Hand"/>
        </Style>
    </Window.Resources>

    <DockPanel Margin="16">

        <!-- ── Header ── -->
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <TextBlock Text="Complementos (plugins)"
                       FontSize="18" FontWeight="SemiBold"
                       Foreground="{DynamicResource Foreground}"/>
            <TextBlock Margin="0,4,0,0" FontSize="11" TextWrapping="Wrap"
                       Foreground="{DynamicResource SubtleForeground}">
                <Run Text="Carpeta: "/><Run Text="{Binding PluginsFolder, Mode=OneWay}"/>
            </TextBlock>
        </StackPanel>

        <!-- ── Footer ── -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Recargar" Command="{Binding ReloadCommand}"/>
            <Button Content="Cerrar"   IsCancel="True"/>
        </StackPanel>

        <!-- ── Plugin list ── -->
        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4">
            <Grid>
                <!-- Empty state -->
                <TextBlock Text="No se detectaron plugins en la carpeta Plugins/."
                           Foreground="{DynamicResource SubtleForeground}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           FontSize="12"
                           Visibility="{Binding HasPlugins, Converter={StaticResource InverseBoolToVisConverter}}"/>

                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding HasPlugins, Converter={StaticResource BoolToVisConverter}}">
                    <ItemsControl ItemsSource="{Binding Plugins}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="12,10"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}"
                                                           FontWeight="SemiBold" FontSize="14"
                                                           Foreground="{DynamicResource Foreground}"
                                                           VerticalAlignment="Center"/>
                                                <Border Margin="8,0,0,0" Padding="5,1" CornerRadius="3"
                                                        VerticalAlignment="Center"
                                                        Background="{DynamicResource HoverBackground}">
                                                    <TextBlock Text="{Binding Version}" FontSize="10"
                                                               Foreground="{DynamicResource SubtleForeground}"/>
                                                </Border>
                                                <TextBlock Text="{Binding StateText}" Margin="8,0,0,0"
                                                           FontSize="10" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource SubtleForeground}"/>
                                            </StackPanel>

                                            <TextBlock Text="{Binding Description}" TextWrapping="Wrap"
                                                       Margin="0,3,8,0" FontSize="12"
                                                       Foreground="{DynamicResource SubtleForeground}"/>

                                            <TextBlock Text="{Binding Author, StringFormat='por {0}'}"
                                                       Margin="0,2,0,0" FontSize="10"
                                                       Foreground="{DynamicResource SubtleForeground}"/>

                                            <TextBlock Text="{Binding Error}" TextWrapping="Wrap"
                                                       Margin="0,4,8,0" FontSize="11"
                                                       Foreground="#E06C75"
                                                       Visibility="{Binding IsFailed, Converter={StaticResource BoolToVisConverter}}"/>
                                        </StackPanel>

                                        <CheckBox Grid.Column="1" VerticalAlignment="Center"
                                                  Content="Activado"
                                                  Cursor="Hand"
                                                  Foreground="{DynamicResource Foreground}"
                                                  IsChecked="{Binding Enabled, Mode=TwoWay}"
                                                  IsEnabled="{Binding CanToggle}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </DockPanel>
</Window>
