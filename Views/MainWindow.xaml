<Window x:Class="MarkdownVault.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:local="clr-namespace:MarkdownVault.Views"
        xmlns:vm="clr-namespace:MarkdownVault.ViewModels"
        xmlns:models="clr-namespace:MarkdownVault.Models"
        Title="{Binding FocusedGroup.Title}"
        Icon="pack://application:,,,/image/barra.ico"
        Height="800" Width="1300"
        MinHeight="500" MinWidth="800"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackground}"
        Closing="Window_Closing">

    <Window.InputBindings>
        <KeyBinding Key="S" Modifiers="Ctrl"            Command="{Binding FocusedGroup.SaveCommand}"/>
        <KeyBinding Key="S" Modifiers="Ctrl+Shift"   Command="{Binding FocusedGroup.SaveAsCommand}"/>
        <KeyBinding Key="N" Modifiers="Ctrl"       Command="{Binding NewFileCommand}"/>
        <KeyBinding Key="W" Modifiers="Ctrl"       Command="{Binding FocusedGroup.CloseTabCommand}"
                    CommandParameter="{Binding FocusedGroup.ActiveTab}"/>
        <KeyBinding Key="Tab" Modifiers="Ctrl"     Command="{Binding FocusedGroup.NextTabCommand}"/>
        <KeyBinding Key="Tab" Modifiers="Ctrl+Shift" Command="{Binding FocusedGroup.PreviousTabCommand}"/>
        <KeyBinding Key="OemPipe" Modifiers="Ctrl" Command="{Binding ToggleExplorerCommand}"/>
        <KeyBinding Key="OemPipe" Modifiers="Ctrl+Alt" Command="{Binding ToggleSplitCommand}"/>
        <KeyBinding Key="Left" Modifiers="Alt"     Command="{Binding FocusedGroup.GoBackCommand}"/>
        <KeyBinding Key="OemPlus"  Modifiers="Ctrl" Command="{Binding IncreaseFontSizeCommand}"/>
        <KeyBinding Key="OemMinus" Modifiers="Ctrl" Command="{Binding DecreaseFontSizeCommand}"/>
        <KeyBinding Key="D0"       Modifiers="Ctrl" Command="{Binding ResetPreviewZoomCommand}"/>
        <!-- Buscar / Reemplazar. Van contra RoutedUICommands (no contra el VM) porque lo
             que hacen es abrir una ventana — ver Views/FindCommands.cs. -->
        <KeyBinding Key="F"  Modifiers="Ctrl"  Command="{x:Static local:FindCommands.Find}"/>
        <KeyBinding Key="H"  Modifiers="Ctrl"  Command="{x:Static local:FindCommands.Replace}"/>
        <KeyBinding Key="F3"                   Command="{x:Static local:FindCommands.FindNext}"/>
        <KeyBinding Key="F3" Modifiers="Shift" Command="{x:Static local:FindCommands.FindPrevious}"/>
    </Window.InputBindings>

    <Window.CommandBindings>
        <CommandBinding Command="{x:Static local:FindCommands.Find}"         Executed="Find_Executed"/>
        <CommandBinding Command="{x:Static local:FindCommands.Replace}"      Executed="Replace_Executed"/>
        <CommandBinding Command="{x:Static local:FindCommands.FindNext}"     Executed="FindNext_Executed"/>
        <CommandBinding Command="{x:Static local:FindCommands.FindPrevious}" Executed="FindPrevious_Executed"/>
    </Window.CommandBindings>

    <Window.Resources>
        <!-- VS Code-style view-mode layout toggle button -->
        <Style x:Key="ViewToggleButtonStyle" TargetType="Button"
               BasedOn="{StaticResource IconButtonStyle}">
            <Setter Property="Width"  Value="28"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Margin" Value="1,0"/>
        </Style>
    </Window.Resources>

    <DockPanel>

        <!-- ── Menu bar + view-mode toggles ── -->
        <DockPanel DockPanel.Dock="Top"
                   Background="{DynamicResource ToolBarBackground}">

            <!-- View-mode layout toggles (always visible, work in every mode) -->
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                        VerticalAlignment="Center" Margin="4,0,8,0">

                <!-- Toggle explorer: sidebar panel (highlighted while shown) -->
                <Button ToolTip="Mostrar/ocultar explorador (Ctrl+\)"
                        Command="{Binding ToggleExplorerCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource ViewToggleButtonStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsExplorerVisible}" Value="True">
                                    <Setter Property="Background" Value="#094771"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <Viewbox Width="16" Height="16">
                        <Grid>
                            <Path Data="M2.5,3.5 H6 V12.5 H2.5 Z"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Opacity="0.4"/>
                            <Path Data="M2.5,3.5 H13.5 V12.5 H2.5 Z M6,3.5 V12.5"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.2" StrokeLineJoin="Round"/>
                        </Grid>
                    </Viewbox>
                </Button>

                <Border Width="1" Margin="5,4" Background="{DynamicResource BorderBrush}"/>

                <!-- Solo editor: single left pane active -->
                <Button ToolTip="Solo editor"
                        Command="{Binding SetViewModeCommand}"
                        CommandParameter="{x:Static models:ViewMode.EditorOnly}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource ViewToggleButtonStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ViewMode}" Value="{x:Static models:ViewMode.EditorOnly}">
                                    <Setter Property="Background" Value="#094771"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <Viewbox Width="16" Height="16">
                        <Grid>
                            <Path Data="M2.5,3.5 H8 V12.5 H2.5 Z"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Opacity="0.5"/>
                            <Path Data="M2.5,3.5 H13.5 V12.5 H2.5 Z M8,3.5 V12.5"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.2" StrokeLineJoin="Round"/>
                        </Grid>
                    </Viewbox>
                </Button>

                <!-- Editor + vista: two side-by-side panes -->
                <Button ToolTip="Editor y vista previa"
                        Command="{Binding SetViewModeCommand}"
                        CommandParameter="{x:Static models:ViewMode.EditAndPreview}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource ViewToggleButtonStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ViewMode}" Value="{x:Static models:ViewMode.EditAndPreview}">
                                    <Setter Property="Background" Value="#094771"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <Viewbox Width="16" Height="16">
                        <Path Data="M2.5,3.5 H13.5 V12.5 H2.5 Z M8,3.5 V12.5"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.2" StrokeLineJoin="Round"/>
                    </Viewbox>
                </Button>

                <!-- Solo visor: single right pane active -->
                <Button ToolTip="Solo visor"
                        Command="{Binding SetViewModeCommand}"
                        CommandParameter="{x:Static models:ViewMode.ViewerOnly}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource ViewToggleButtonStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ViewMode}" Value="{x:Static models:ViewMode.ViewerOnly}">
                                    <Setter Property="Background" Value="#094771"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <Viewbox Width="16" Height="16">
                        <Grid>
                            <Path Data="M8,3.5 H13.5 V12.5 H8 Z"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Opacity="0.5"/>
                            <Path Data="M2.5,3.5 H13.5 V12.5 H2.5 Z M8,3.5 V12.5"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.2" StrokeLineJoin="Round"/>
                        </Grid>
                    </Viewbox>
                </Button>

                <Border Width="1" Margin="5,4" Background="{DynamicResource BorderBrush}"/>

                <!-- Split editor toggle (highlighted while split).
                     Frame + divider like "Editor y vista previa", plus a "+" in the right
                     half so the two are distinguishable at 16px: this one ADDS a pane. -->
                <Button ToolTip="Dividir editor (Ctrl+Alt+\)"
                        Command="{Binding ToggleSplitCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource ViewToggleButtonStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSplit}" Value="True">
                                    <Setter Property="Background" Value="#094771"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <Viewbox Width="16" Height="16">
                        <Grid>
                            <Path Data="M2.5,3.5 H13.5 V12.5 H2.5 Z M8,3.5 V12.5"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.2" StrokeLineJoin="Round"/>
                            <Path Data="M10.75,6.5 V9.5 M9.25,8 H12.25"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        </Grid>
                    </Viewbox>
                </Button>

                <!-- Comparar archivos: aparece SOLO con el editor dividido (IsSplit); el
                     comando se auto-deshabilita hasta que ambos paneles tengan un archivo.
                     Ícono: dos documentos con flechas de ida y vuelta entre ellos. -->
                <Button ToolTip="Comparar archivos (panel A ↔ B)"
                        Command="{Binding CompareFilesCommand}"
                        Style="{StaticResource ViewToggleButtonStyle}"
                        Visibility="{Binding IsSplit, Converter={StaticResource BoolToVisConverter}}">
                    <Viewbox Width="16" Height="16">
                        <Grid>
                            <Path Data="M2.5,3 H6.5 V13 H2.5 Z M9.5,3 H13.5 V13 H9.5 Z"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.2" StrokeLineJoin="Round"/>
                            <Path Data="M6.9,7 H9.1 M8.2,6.1 L9.2,7 L8.2,7.9 M9.1,10 H6.9 M7.8,9.1 L6.8,10 L7.8,10.9"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.1"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                        </Grid>
                    </Viewbox>
                </Button>

                <Border Width="1" Margin="5,4" Background="{DynamicResource BorderBrush}"/>

                <!-- Graph view toggle (highlighted while active) -->
                <Button ToolTip="Vista de grafo"
                        Command="{Binding ToggleGraphCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource ViewToggleButtonStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ShowGraph}" Value="True">
                                    <Setter Property="Background" Value="#094771"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <Viewbox Width="16" Height="16">
                        <Canvas Width="16" Height="16">
                            <Line X1="4.5" Y1="4.5" X2="12.5" Y2="6.5" Stroke="#8B8B8B" StrokeThickness="1"/>
                            <Line X1="12.5" Y1="6.5" X2="6.5" Y2="12.5" Stroke="#8B8B8B" StrokeThickness="1"/>
                            <Ellipse Canvas.Left="2"  Canvas.Top="2"  Width="5" Height="5" Fill="#6F9FD8"/>
                            <Ellipse Canvas.Left="10" Canvas.Top="4"  Width="5" Height="5" Fill="#6F9FD8"/>
                            <Ellipse Canvas.Left="4"  Canvas.Top="10" Width="5" Height="5" Fill="#6F9FD8"/>
                        </Canvas>
                    </Viewbox>
                </Button>
            </StackPanel>

            <Menu Background="Transparent"
                  Foreground="{DynamicResource Foreground}"
                  FontSize="13">
            <MenuItem Header="_Archivo">
                <MenuItem Header="_Abrir vault…"      Command="{Binding OpenVaultCommand}" InputGestureText="Ctrl+Shift+O"/>
                <MenuItem Header="Administrar _vaults…" Click="ManageVaults_Click"/>
                <MenuItem Header="_Nuevo archivo"     Command="{Binding NewFileCommand}"   InputGestureText="Ctrl+N"/>
                <Separator/>
                <MenuItem Header="_Guardar"         Command="{Binding FocusedGroup.SaveCommand}"   InputGestureText="Ctrl+S"/>
                <MenuItem Header="Guardar _como…"   Command="{Binding FocusedGroup.SaveAsCommand}" InputGestureText="Ctrl+Shift+S"/>
                <Separator/>
                <MenuItem Header="E_xportar vista a PNG…" Click="ExportToPng_Click" InputGestureText="Ctrl+Shift+P"/>
                <MenuItem Header="Exportar a _PDF…"        Click="ExportToPdf_Click"/>
                <Separator/>
                <MenuItem Header="_Salir" Click="Exit_Click"/>
            </MenuItem>
            <MenuItem Header="_Editar">
                <MenuItem Header="_Buscar…"
                          Command="{x:Static local:FindCommands.Find}"
                          InputGestureText="Ctrl+F"/>
                <MenuItem Header="_Reemplazar…"
                          Command="{x:Static local:FindCommands.Replace}"
                          InputGestureText="Ctrl+H"/>
                <Separator/>
                <MenuItem Header="Buscar _siguiente"
                          Command="{x:Static local:FindCommands.FindNext}"
                          InputGestureText="F3"/>
                <MenuItem Header="Buscar _anterior"
                          Command="{x:Static local:FindCommands.FindPrevious}"
                          InputGestureText="Shift+F3"/>
            </MenuItem>
            <MenuItem Header="_Vista">
                <MenuItem Header="_Explorador"
                          Command="{Binding ToggleExplorerCommand}"
                          InputGestureText="Ctrl+\"/>
                <MenuItem Header="_Dividir editor"
                          Command="{Binding ToggleSplitCommand}"
                          InputGestureText="Ctrl+Alt+\"/>
                <Separator/>
                <MenuItem Header="Solo _editor"
                          Command="{Binding SetViewModeCommand}"
                          CommandParameter="{x:Static models:ViewMode.EditorOnly}"/>
                <MenuItem Header="_Editor y vista previa"
                          Command="{Binding SetViewModeCommand}"
                          CommandParameter="{x:Static models:ViewMode.EditAndPreview}"/>
                <MenuItem Header="Solo _visor"
                          Command="{Binding SetViewModeCommand}"
                          CommandParameter="{x:Static models:ViewMode.ViewerOnly}"/>
                <Separator/>
                <MenuItem Header="Aumentar fuente y zoom" Command="{Binding IncreaseFontSizeCommand}" InputGestureText="Ctrl++"/>
                <MenuItem Header="Reducir fuente y zoom"  Command="{Binding DecreaseFontSizeCommand}" InputGestureText="Ctrl+-"/>
                <MenuItem Header="Restablecer zoom"        Command="{Binding ResetPreviewZoomCommand}" InputGestureText="Ctrl+0"/>
                <Separator/>
                <MenuItem Header="Cambiar _tema"   Command="{Binding ToggleThemeCommand}"/>
            </MenuItem>
            <MenuItem Header="_Complementos">
                <MenuItem Header="Administrar _plugins…" Click="Plugins_Click"/>
            </MenuItem>
            <MenuItem Header="Acerca _de">
                <MenuItem Header="Acerca de _MarkdownVault…" Click="About_Click"/>
            </MenuItem>
            </Menu>
        </DockPanel>

        <!-- ── Status bar ── -->
        <StatusBar DockPanel.Dock="Bottom"
                   Background="{DynamicResource StatusBarBackground}"
                   Foreground="{DynamicResource StatusBarForeground}"
                   FontSize="12">
            <StatusBarItem>
                <TextBlock>
                    <Run Text="Vault: " />
                    <Run Text="{Binding VaultName, Mode=OneWay}"/>
                </TextBlock>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock>
                    <Run Text="Lín "/>
                    <Run Text="{Binding FocusedGroup.CurrentLine, Mode=OneWay}"/>
                    <Run Text=", Col "/>
                    <Run Text="{Binding FocusedGroup.CurrentColumn, Mode=OneWay}"/>
                </TextBlock>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock>
                    <Run Text="{Binding FocusedGroup.WordCount, Mode=OneWay}"/>
                    <Run Text=" palabras"/>
                </TextBlock>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock Text="{Binding StatusMessage, Mode=OneWay}"
                           Foreground="{DynamicResource StatusBarForeground}"/>
            </StatusBarItem>
        </StatusBar>

        <!-- ── Barra de progreso de plugins (SDK 1.3.0) ──────────────────────
             Va DESPUÉS del StatusBar y también con Dock="Bottom": en un DockPanel
             los hijos anclados al mismo borde se apilan hacia adentro en orden de
             declaración, así que el StatusBar se queda con el borde inferior y esta
             banda se acomoda justo encima. Ocupa el ancho completo a propósito —
             el problema que resuelve es que un texto en un rincón no se ve.

             No usa ToolBar: el WPF ToolBar impone sus propios estilos implícitos
             (ToolBar.ButtonStyleKey) y habría que remapearlos para el tema oscuro
             (ver AGENTS.md). Un Border + Grid no tiene ese problema y todos los
             pinceles salen del diccionario de tema por DynamicResource. -->
        <Border DockPanel.Dock="Bottom"
                Visibility="{Binding IsProgressVisible, Converter={StaticResource BoolToVisConverter}}"
                Background="{DynamicResource PanelBackground}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="10,6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>   <!-- título -->
                    <ColumnDefinition Width="*"/>      <!-- paso actual -->
                    <ColumnDefinition Width="Auto"/>   <!-- "+N en segundo plano" -->
                    <ColumnDefinition Width="Auto"/>   <!-- porcentaje -->
                    <ColumnDefinition Width="Auto"/>   <!-- cancelar -->
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0"
                           Text="{Binding ProgressTitle, Mode=OneWay}"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource Foreground}"
                           VerticalAlignment="Center"/>

                <TextBlock Grid.Row="0" Grid.Column="1"
                           Text="{Binding ProgressMessage, Mode=OneWay}"
                           Margin="10,0,10,0"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource SubtleForeground}"
                           VerticalAlignment="Center"/>

                <TextBlock Grid.Row="0" Grid.Column="2"
                           Text="{Binding ProgressOthersText, Mode=OneWay}"
                           Margin="0,0,10,0"
                           FontStyle="Italic"
                           Foreground="{DynamicResource SubtleForeground}"
                           VerticalAlignment="Center"/>

                <TextBlock Grid.Row="0" Grid.Column="3"
                           Text="{Binding ProgressPercentText, Mode=OneWay}"
                           MinWidth="44"
                           TextAlignment="Right"
                           Foreground="{DynamicResource Foreground}"
                           VerticalAlignment="Center"/>

                <!-- Rowspan 2: el botón queda centrado contra el bloque entero
                     (texto + barra), no colgado de la primera línea. -->
                <Button Grid.Row="0" Grid.Column="4" Grid.RowSpan="2"
                        Content="{Binding ProgressCancelLabel, Mode=OneWay}"
                        Command="{Binding CancelProgressCommand}"
                        Style="{DynamicResource ToolbarButtonStyle}"
                        Margin="14,0,0,0"
                        VerticalAlignment="Center"/>

                <ProgressBar Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="4"
                             Height="6"
                             Margin="0,6,0,0"
                             Minimum="0" Maximum="100"
                             Value="{Binding ProgressPercent, Mode=OneWay}"
                             IsIndeterminate="{Binding IsProgressIndeterminate, Mode=OneWay}"
                             Foreground="{DynamicResource AccentBrush}"
                             Background="{DynamicResource WindowBackground}"
                             BorderBrush="{DynamicResource BorderBrush}"
                             BorderThickness="1"/>
            </Grid>
        </Border>

        <!-- ── Main layout: FileTree | Editor | Preview ── -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ExplorerColumn" Width="240" MinWidth="0" MaxWidth="500"/>
                <ColumnDefinition x:Name="ExplorerSplitterColumn" Width="4"/>
                <ColumnDefinition x:Name="EditorColumn"      Width="*" MinWidth="200"/>
                <ColumnDefinition x:Name="MidSplitterColumn" Width="4"/>
                <ColumnDefinition x:Name="PreviewColumn"     Width="*" MinWidth="200"/>
            </Grid.ColumnDefinitions>

            <!-- File tree -->
            <local:FileTreeView Grid.Column="0"
                                x:Name="FileTreePanel"
                                DataContext="{Binding FileTree}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="0,0,1,0"/>

            <!-- Splitter between explorer and editor -->
            <GridSplitter Grid.Column="1"
                          x:Name="ExplorerSplitter"
                          Width="4"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Background="{DynamicResource SplitterBackground}"
                          ShowsPreview="True"/>

            <!-- Editor region (Phase 4): nested grid holding pane A / splitter / pane B.
                 Workbench properties are reached with DataContext.X through the Window, NOT
                 a bare {Binding X, RelativeSource=Window}: that form targets a property on the
                 Window OBJECT, which has no ShowGraph/IsSplit, so it fails silently and
                 Visibility falls back to its Visible default. FontFamily/FontSize below can
                 use the bare form only because Window genuinely has those properties. -->
            <Grid Grid.Column="2"
                  x:Name="EditorRegion"
                  Visibility="{Binding DataContext.ShowGraph, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InverseBoolToVisConverter}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="PaneAColumn"        Width="*" MinWidth="150"/>
                    <ColumnDefinition x:Name="PaneSplitterColumn" Width="4"/>
                    <ColumnDefinition x:Name="PaneBColumn"        Width="0" MinWidth="0"/>
                </Grid.ColumnDefinitions>

                <!-- Pane A — always present (Groups[0], the primary group, never auto-collapses). -->
                <local:EditorView Grid.Column="0"
                                  DataContext="{Binding Groups[0]}"
                                  x:Name="EditorPanelA"
                                  FontFamily="{Binding FontFamily, RelativeSource={RelativeSource AncestorType=Window}}"
                                  FontSize="{Binding FontSize, RelativeSource={RelativeSource AncestorType=Window}}"/>

                <!-- Splitter between pane A and pane B — captures SplitRatio on drag (task 4.11). -->
                <GridSplitter Grid.Column="1"
                              x:Name="PaneSplitter"
                              Width="4"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch"
                              Background="{DynamicResource SplitterBackground}"
                              ShowsPreview="True"
                              DragCompleted="PaneSplitter_DragCompleted"
                              Visibility="{Binding DataContext.IsSplit, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisConverter}}"/>

                <!-- Pane B — born empty on split (SE-1), collapses when unsplit. Binding
                     Groups[1] fails silently while it doesn't exist yet; WPF re-evaluates it
                     automatically on Groups' CollectionChanged (ObservableCollection indexer
                     binding support), so it resolves the moment EnterSplit adds the group. -->
                <local:EditorView Grid.Column="2"
                                  DataContext="{Binding Groups[1]}"
                                  x:Name="EditorPanelB"
                                  FontFamily="{Binding FontFamily, RelativeSource={RelativeSource AncestorType=Window}}"
                                  FontSize="{Binding FontSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                  Visibility="{Binding DataContext.IsSplit, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisConverter}}"/>
            </Grid>

            <!-- Graph view (workbench-scoped, Phase 2/Decision 2) — replaces the whole editor
                 region (both panes) while active. Sits as a sibling of EditorRegion in the
                 SAME outer column rather than nested with a ColumnSpan: the outer column is
                 already a single "*" track, so a sibling occupies the identical area with less
                 restructuring, and reuses the GraphView bindings verified in the prior batch
                 unchanged (deliberate, documented deviation from design §6.1's literal
                 "ColumnSpan=3 inside the nested grid" — same visible behavior, lower risk). -->
            <local:GraphView Grid.Column="2"
                             DataContext="{Binding Graph}"
                             Visibility="{Binding DataContext.ShowGraph, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisConverter}}"/>

            <GridSplitter Grid.Column="3"
                          Width="4"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Background="{DynamicResource SplitterBackground}"
                          ShowsPreview="True"/>

            <!-- Preview (WebView2) -->
            <Border Grid.Column="4"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1,0,0,0"
                    Visibility="{Binding ShowPreviewPanel,
                                 Converter={StaticResource BoolToVisConverter}}">
                <DockPanel>
                    <!-- Solo visor: the editor pane (and its own tab strip) is collapsed, so
                         surface the focused group's tabs here so files can still be switched
                         while reading. Visibility is driven imperatively in ApplyViewMode
                         (only in ViewerOnly); the inner strip also self-hides when the group
                         has no file. -->
                    <local:TabStripView x:Name="PreviewTabStrip"
                                        DockPanel.Dock="Top"
                                        DataContext="{Binding FocusedGroup}"
                                        Visibility="Collapsed"/>
                    <!-- DefaultBackgroundColor is set in code-behind to match the
                         active theme, so file switches don't flash white/light. -->
                    <wv2:WebView2 x:Name="PreviewWebView"/>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
