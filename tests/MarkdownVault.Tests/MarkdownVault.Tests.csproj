<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net8.0-windows because it references the WPF host project. -->
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk"        Version="17.11.1" />
    <PackageReference Include="xunit"                         Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio"     Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\MarkdownVault.csproj" />
    <ProjectReference Include="..\..\PluginSdk\MarkdownVault.PluginSdk.csproj" />
    <!-- NO hay ProjectReference a NINGÚN plugin, a propósito. Un plugin es OPCIONAL:
         si estos tests lo referenciaran, borrar el plugin del repo dejaría al proyecto
         de tests del host sin compilar y se caerían tests que no tienen nada que ver
         con él. Cada plugin lleva ahora su propio proyecto de tests, dentro de su
         carpeta (plugins\<Plugin>\tests\). Los tests de integración de esta carpeta
         que necesitan un plugin REAL (CopyButton, Mermaid, Eisenhower) lo cargan por
         RUTA desde bin\<Config>\net8.0-windows\Plugins — es decir, dependen de un
         build de la SOLUCIÓN, no de una referencia de compilación. -->
    <!-- Build-and-copy only: MarkdownVault.Plugin.TestFixture.dll lands next to
         MarkdownVault.Tests.dll. Its types are never referenced directly in IL here
         (see Collectible_context_with_wpf_window_and_filestream_is_unloaded_after_gc) —
         PluginManager.LoadUnloadWithWorkForTest loads it by path + reflection so this
         ProjectReference doesn't defeat ALC collectibility. Es del MECANISMO DE CARGA
         del host, no de ningún plugin del catálogo: se queda. -->
    <ProjectReference Include="..\Plugin.TestFixture\MarkdownVault.Plugin.TestFixture.csproj" />
  </ItemGroup>

</Project>
